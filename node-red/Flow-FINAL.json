    {
        "id": "aaa54a3242aee704",
        "type": "function",
        "z": "9950c2ddb1a41706",
        "name": "Calcula ON/OFF",
        "func": "const CYCLE_S = 40;\nconst pwm = parseFloat(msg.payload.pwm);\n\nif (isNaN(pwm) || pwm < 0 || pwm > 100) {\n    node.warn('PWM inválido: ' + msg.payload.pwm);\n    return null;\n}\n\nconst on_ms  = Math.round((pwm / 100) * CYCLE_S * 1000);\nconst off_ms = Math.round(CYCLE_S * 1000 - on_ms);\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: pwm + '% → ON ' + (on_ms/1000) + 's / OFF ' + (off_ms/1000) + 's'\n});\n\nconst httpMsg = { res: msg.res, payload: { ok: true, pwm, on_ms, off_ms } };\n\n// Liga imediatamente\nnode.send([ httpMsg, { payload: '1' }, null ]);\n\n// Desliga após on_ms\nsetTimeout(() => {\n    node.send([ null, null, { payload: '0' } ]);\n\n    // Aguarda off_ms e reinicia o ciclo se não chegou novo PWM\n    setTimeout(() => {\n        node.send([ null, { payload: '1' }, null ]);\n    }, off_ms);\n\n}, on_ms);\n\nreturn null;",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
